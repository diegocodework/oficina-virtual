<Window x:Class="OficinaVirtual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OficinaVirtual"
        mc:Ignorable="d"
        Title="Oficina Virtual" Height="750" Width="1200"
        SizeChanged="Window_SizeChanged" LocationChanged="Window_LocationChanged"
        StateChanged="Window_StateChanged" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6" Background="#FF1B1E27">
            <Button x:Name="SaveWorkspaceButton" Content="Guardar workspace" Margin="0,0,10,0" Click="SaveWorkspaceButton_Click"/>
            <TextBlock x:Name="WorkspaceStatusText" VerticalAlignment="Center" Foreground="#FFE4A15C" FontSize="11"/>
        </StackPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="1" SelectionChanged="MainTabControl_SelectionChanged"/>
    </Grid>
</Window>
