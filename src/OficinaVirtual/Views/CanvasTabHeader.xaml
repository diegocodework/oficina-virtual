<UserControl x:Class="OficinaVirtual.Views.CanvasTabHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <Grid VerticalAlignment="Center">
            <TextBlock x:Name="NameText" VerticalAlignment="Center"
                       ToolTip="Doble clic para renombrar"
                       MouseLeftButtonDown="NameText_MouseLeftButtonDown"/>
            <TextBox x:Name="NameEditor" Visibility="Collapsed" MinWidth="90" Padding="2,0"
                     Background="#FF262B3A" Foreground="#FFE4E6EB" CaretBrush="#FFE4E6EB"
                     BorderBrush="#FF3E5C8A" BorderThickness="1"
                     KeyDown="NameEditor_KeyDown" LostKeyboardFocus="NameEditor_LostKeyboardFocus"/>
        </Grid>
        <Button x:Name="CloseTabButton" Content="✕" Margin="8,0,0,0" Padding="4,0" FontSize="10"
                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                ToolTip="Cerrar pestaña" Click="CloseTabButton_Click"/>
    </StackPanel>
</UserControl>
