<UserControl x:Class="OficinaVirtual.Views.EmbeddedWindowFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <!-- Modo icono: cuadrado con el icono nativo de la app; sin ventana real visible aquí. -->
        <Border x:Name="IconView" Background="#FF2D2D30" CornerRadius="6" Cursor="Hand"
                BorderThickness="3" BorderBrush="Transparent"
                MouseLeftButtonDown="IconView_MouseLeftButtonDown"
                MouseMove="IconView_MouseMove"
                MouseLeftButtonUp="IconView_MouseLeftButtonUp">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6">
                <Image x:Name="IconImage" Width="40" Height="40" Margin="0,0,0,4"/>
                <TextBlock x:Name="IconTitleText" Foreground="White" FontSize="10" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="28"/>
            </StackPanel>
        </Border>

        <!-- Modo tamaño real: el marco arrastrable/redimensionable con la ventana embebida. -->
        <Grid x:Name="ExpandedView" Visibility="Collapsed">
            <Border x:Name="RootBorder" BorderBrush="#FF555555" BorderThickness="10" Background="#FF1E1E1E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF2D2D30" x:Name="HeaderBar" Cursor="SizeAll"
                            MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                            MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp"
                            MouseMove="HeaderBar_MouseMove">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="240"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TitleText" Grid.Column="0" Foreground="White" VerticalAlignment="Center"
                                       Margin="8,0" TextTrimming="CharacterEllipsis" FontSize="12"/>
                            <!-- Réplica del menú clásico de la app (Archivo, Edición...), que Windows no
                                 dibuja en ventanas embebidas. Vacío y oculto si la app no tiene. -->
                            <Menu x:Name="NativeMenuBar" Grid.Column="1" Background="Transparent" Foreground="White"
                                  VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"/>
                            <Button x:Name="CloseButton" Grid.Column="2" Content="✕" Width="28" Background="Transparent"
                                    BorderThickness="0" Foreground="White" Click="CloseButton_Click"
                                    ToolTip="Pasar a icono"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" x:Name="EmbedTarget" Background="Black"/>
                </Grid>
            </Border>

            <!-- Tiradores de redimensionado: 4 lados + 4 esquinas -->
            <Thumb x:Name="ThumbLeft" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Cursor="SizeWE" DragDelta="ThumbLeft_DragDelta" Background="Transparent" Margin="0,10,0,10"/>
            <Thumb x:Name="ThumbRight" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Cursor="SizeWE" DragDelta="ThumbRight_DragDelta" Background="Transparent" Margin="0,10,0,10"/>
            <Thumb x:Name="ThumbTop" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Cursor="SizeNS" DragDelta="ThumbTop_DragDelta" Background="Transparent" Margin="10,0,10,0"/>
            <Thumb x:Name="ThumbBottom" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Cursor="SizeNS" DragDelta="ThumbBottom_DragDelta" Background="Transparent" Margin="10,0,10,0"/>

            <Thumb x:Name="ThumbTopLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" DragDelta="ThumbTopLeft_DragDelta" Background="Transparent"/>
            <Thumb x:Name="ThumbTopRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" DragDelta="ThumbTopRight_DragDelta" Background="Transparent"/>
            <Thumb x:Name="ThumbBottomLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" DragDelta="ThumbBottomLeft_DragDelta" Background="Transparent"/>
            <Thumb x:Name="ThumbBottomRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="ThumbBottomRight_DragDelta" Background="Transparent"/>
        </Grid>

        <!-- Conectores tipo ComfyUI: arrastrar desde aquí para dibujar un cable hasta otro nodo.
             Encima de todo (últimos en el árbol) y con alineación relativa, así que se reposicionan
             solos al cambiar entre modo Icono y Expandido sin código adicional. -->
        <Ellipse x:Name="ConnectorLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-6,0,0,0" Fill="#FF9AA5B1" Stroke="#FF1E1E1E" StrokeThickness="1.5" Cursor="Hand"
                 MouseLeftButtonDown="ConnectorLeft_MouseLeftButtonDown"/>
        <Ellipse x:Name="ConnectorRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,-6,0" Fill="#FF9AA5B1" Stroke="#FF1E1E1E" StrokeThickness="1.5" Cursor="Hand"
                 MouseLeftButtonDown="ConnectorRight_MouseLeftButtonDown"/>
    </Grid>
</UserControl>
